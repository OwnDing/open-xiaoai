# Pinned image (optional). Defaults to nousresearch/hermes-agent:latest.
HERMES_IMAGE=nousresearch/hermes-agent:latest

# Bearer key Xiaozhi uses to call Hermes (any long random string).
API_SERVER_KEY=

# DeepSeek key used by Hermes itself.
DEEPSEEK_API_KEY=

# Web search: either a Tavily key or a SearXNG instance.
TAVILY_API_KEY=
# SEARXNG_URL=http://searxng:8080

# Home Assistant long-lived access token.
HASS_URL=http://homeassistant:8123
HASS_TOKEN=

# QQ official bot (q.qq.com): chat with 小七 from QQ and receive notifications.
# QQ_APP_ID=
# QQ_CLIENT_SECRET=
# Openid of the paired user that `hermes send -t qqbot` and cron jobs deliver to.
# QQBOT_HOME_CHANNEL=

# Secret Home Assistant sends (header X-Gitlab-Token) to the webhook route ha-alert;
# the same value is hermes_webhook_secret in HA's secrets.yaml.
# WEBHOOK_SECRET=

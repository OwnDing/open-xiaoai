  "lines": {
    "U01": {"role": "user",     "text": "你好小七。"},
    "Q01": {"role": "xiaoqi",   "text": "我在。"},
    "U02": {"role": "user",     "text": "开电视，我想看《雾港》第二集。", "tts": "开电视，我想看雾港第二集。"},
    "Q02": {"role": "xiaoqi",   "text": "好的，《雾港》第二集，开始播放。", "tts": "好的，雾港第二集，开始播放。"},
    "N01": {"role": "narrator", "text": "一句话，电视就全听你的。"},
    "N02": {"role": "narrator", "text": "可在今天的智能家居里，电视只是一个开关。"},
    "U03": {"role": "user",     "text": "打开电视。"},
    "X01": {"role": "generic",  "text": "好的。"},
    "U04": {"role": "user",     "text": "我想看《雾港》第二集。", "tts": "我想看雾港第二集。"},
    "X02": {"role": "generic",  "text": "抱歉，这个我还不会。"},
    "N03": {"role": "narrator", "text": "剩下的，还得靠遥控器：找应用，拼片名，翻选集，一下一下地按。"},
    "N04": {"role": "narrator", "text": "电视自带的语音，要按住遥控器才肯听；换个牌子，又是另一套，也管不了家里的其他设备。"},
    "N05": {"role": "narrator", "text": "如果，屏幕上的每一个按钮，小七都能替你按呢？"},
    "N06": {"role": "narrator", "text": "小七还是那一套：一个音箱，一台迷你主机。这一次，电视上多了一个小助手。"},
    "N07": {"role": "narrator", "text": "它是小七的眼睛：不到零点三秒，就能读完整块屏幕。"},
    "N08": {"role": "narrator", "text": "也是小七的手：打字，点按钮，按遥控键，控制播放。"},
    "N09": {"role": "narrator", "text": "开机借音箱的红外，其余操作，全走家里的局域网。"},
    "N10": {"role": "narrator", "text": "再看开头那句话。小七看着屏幕，一步一步替你做完。"},
    "N11": {"role": "narrator", "text": "屏幕上真的是第二集了，它才说开始播放。"},
    "U05": {"role": "user",     "text": "下一集。"},
    "Q03": {"role": "xiaoqi",   "text": "第三集来了。"},
    "U06": {"role": "user",     "text": "快进两分钟。"},
    "Q04": {"role": "xiaoqi",   "text": "播到十四分二十秒了。"},
    "U07": {"role": "user",     "text": "声音小一点。"},
    "Q05": {"role": "xiaoqi",   "text": "音量调到十二了。"},
    "U08": {"role": "user",     "text": "在电视上放网易云的每日推荐。"},
    "Q06": {"role": "xiaoqi",   "text": "好，每日推荐，开始播放。"},
    "U09": {"role": "user",     "text": "打开浏览器，搜一下红烧肉怎么做。"},
    "Q07": {"role": "xiaoqi",   "text": "搜好了，菜谱就在电视上。"},
    "U10": {"role": "user",     "text": "好了，关电视吧。"},
    "Q08": {"role": "xiaoqi",   "text": "电视关了，晚安。"},
    "N12": {"role": "narrator", "text": "开机，找片，选集，上网，听歌。电视上的每一步，都交给一句话。"},
    "N13": {"role": "narrator", "text": "遥控器，可以退休了。"},
    "N14": {"role": "narrator", "text": "Open-XiaoAI，让小七，接管你家的电视。", "tts": "Open 小爱 AI，让小七，接管你家的电视。"}

  "lines": {
    "U01": {"role": "user",     "text": "你好小七。"},
    "Q01": {"role": "xiaoqi",   "text": "我在。"},
    "U02": {"role": "user",     "text": "我回来了。"},
    "Q02": {"role": "xiaoqi",   "text": "欢迎回家。灯开好了，空调调到二十六度。"},
    "N01": {"role": "narrator", "text": "一句话，整个家都醒了。"},
    "N02": {"role": "narrator", "text": "可现在的智能家居，总是差一口气。"},
    "U03": {"role": "user",     "text": "我有点冷。"},
    "X01": {"role": "generic",  "text": "抱歉，我没有听懂。"},
    "N03": {"role": "narrator", "text": "家里的设备来自不同品牌，一个品牌一个 App，谁也不认识谁。"},
    "N04": {"role": "narrator", "text": "更要紧的是，你说的每一句话，都要先传到云端。"},
    "N05": {"role": "narrator", "text": "AI 越懂你，你的隐私就越少。"},
    "N06": {"role": "narrator", "text": "家里，就没有秘密了。"},
    "N07": {"role": "narrator", "text": "如果，家的大脑，就住在家里呢？"},
    "N08": {"role": "narrator", "text": "做一个这样的 AI 管家，只需要两样东西。"},
    "N09": {"role": "narrator", "text": "一台带麦克风的音箱，就是家的耳朵和嘴巴。"},
    "N10": {"role": "narrator", "text": "一台常开的迷你主机，就是家的大脑。"},
    "N11": {"role": "narrator", "text": "再装上开源软件：Hermes 智能体负责思考和记忆，Home Assistant 连接全屋设备。"},
    "N12": {"role": "narrator", "text": "唤醒和语音识别，都在这台主机上完成。"},
    "N13": {"role": "narrator", "text": "你的声音不出家门，交给大模型的，只有一行文字。"},
    "U04": {"role": "user",     "text": "小七，我有点冷，还有点困。"},
    "Q03": {"role": "xiaoqi",   "text": "空调调到二十六度了。今晚早点睡，十点半我提醒你。"},
    "U05": {"role": "user",     "text": "洗衣机洗完了提醒我。"},
    "Q04": {"role": "xiaoqi",   "text": "好，洗完我叫你。"},
    "Q05": {"role": "xiaoqi",   "text": "洗衣机洗好了，记得晾衣服哦。"},
    "U06": {"role": "user",     "text": "以后我说“我回来了”，就开灯，空调调到二十六度。"},
    "Q06": {"role": "xiaoqi",   "text": "好，记住了。"},
    "N14": {"role": "narrator", "text": "不用打开 App，也不用写自动化。家里的规矩，说一遍，它就记住了。"},
    "N15": {"role": "narrator", "text": "这还只是开始。接上摄像头，它就能看见危险。"},
    "Q07": {"role": "xiaoqi",   "text": "厨房的火还开着，已经十分钟没人了，要去看看吗？"},
    "K01": {"role": "child",    "text": "小七，这道题我不会。"},
    "Q08": {"role": "xiaoqi",   "text": "别急，我们先数一数，图上一共有几个苹果？"},
    "N16": {"role": "narrator", "text": "还能陪孩子写作业，不直接给答案，陪他一步步想明白。"},
    "N17": {"role": "narrator", "text": "它听得懂你，管得好全屋，也守得住你的秘密。"},
    "N18": {"role": "narrator", "text": "家的大脑，就该住在家里。"},
    "N19": {"role": "narrator", "text": "Open-XiaoAI，动手做一个，懂你的家。", "tts": "Open 小爱 AI，动手做一个，懂你的家。"}
  }
}
